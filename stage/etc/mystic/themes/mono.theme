# Mono - greyscale only, every channel equal (r == g == b on every line).
# No blur and almost no glow: flat surfaces, crisp glyph edges, nothing to
# mush the text. Maximum legibility, and the cheapest theme to compose.
# Measured with the WCAG formula in docs/THEMES.md:
#   body text 13.92:1 on window_bg, dim text 7.16:1, accent 18.73:1.
name          = Mono
dark          = 1
bg_top        = #0E0E0E
bg_bottom     = #1A1A1A
accent        = #FFFFFF
glow          = #6E6E6E
glow_strength = 0.25
panel         = #B31F1F1F
panel_border  = #4DFFFFFF
text          = #DEDEDE
text_dim      = #A0A0A0
window_bg     = #121212
window_border = #66FFFFFF
corner        = 6
blur          = 0.0

# Icon animation: anim_speed is a pulse multiplier (0 = a still desktop,
# sensible range 0..3); icon_accent is the highlight colour inside every icon.
icon_accent   = #B4B4B4
anim_speed    = 0

# Icon geometry, motion and type. anim is one of none/pulse/glow/drift/orbit/
# wave/spin; icon_style one of solid/outline/duotone/rounded/sharp/pixel;
# font_scale (0.8..1.6) multiplies the user text scale.
anim          = none
anim_amp      = 0
icon_style    = solid
font_ui       = JetBrains Mono
font_mono     = JetBrains Mono
font_scale    = 1.05
