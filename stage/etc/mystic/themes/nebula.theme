# Nebula - violet and indigo, the light of an emission nebula seen from far
# out. Deep and dim, with the accent as the only saturated thing on screen.
#
# Contrast, WCAG 2.1 on the composited 8 bit sRGB values (docs/THEMES.md):
#   text      16.27:1 on window_bg   16.67 / 16.44 on panel (bar / in window)
#   text_dim   6.57:1 on window_bg    6.74 /  6.64 on panel
#   accent     9.04:1 on window_bg    9.27 /  9.14 on panel
# Targets are >= 7:1 for body text, >= 4.5:1 for dim text and accent.
name          = Nebula
dark          = 1
bg_top        = #0A0618
bg_bottom     = #170D33
accent        = #B9A6FF
glow          = #6B3FD4
glow_strength = 0.65
panel         = #A00F0A22
panel_border  = #33B9A6FF
text          = #F0EAFF
text_dim      = #9E90C4
window_bg     = #120B26
window_border = #3A8F7AE0
corner        = 16
blur          = 1.0

# Icon animation: anim_speed is a pulse multiplier (0 = a still desktop,
# sensible range 0..3); icon_accent is the highlight colour inside every icon.
icon_accent   = #7FE7E0
anim_speed    = 0.7

# Icon geometry, motion and type. anim is one of none/pulse/glow/drift/orbit/
# wave/spin; icon_style one of solid/outline/duotone/rounded/sharp/pixel;
# font_scale (0.8..1.6) multiplies the user text scale.
anim          = orbit
anim_amp      = 0.6
icon_style    = duotone
font_ui       = Lato
font_mono     = JetBrains Mono
font_scale    = 1.0
