name          = Sandstone
dark          = 0
bg_top        = #FAF3E6
bg_bottom     = #E8D9C0
accent        = #B44B2C
glow          = #FFF6E4
glow_strength = 0.8
panel         = #C8FFFBF2
panel_border  = #332F2013
text          = #2E2117
text_dim      = #A02E2117
window_bg     = #E8FFFDF8
window_border = #332F2013
corner        = 14
blur          = 1.0

# Icon animation: anim_speed is a pulse multiplier (0 = a still desktop,
# sensible range 0..3); icon_accent is the highlight colour inside every icon.
icon_accent   = #2F5D62
anim_speed    = 0.7

# Icon geometry, motion and type. anim is one of none/pulse/glow/drift/orbit/
# wave/spin; icon_style one of solid/outline/duotone/rounded/sharp/pixel;
# font_scale (0.8..1.6) multiplies the user text scale.
anim          = drift
anim_amp      = 0.6
icon_style    = rounded
font_ui       = Lato
font_mono     = JetBrains Mono
font_scale    = 1.02
