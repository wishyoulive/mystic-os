# Forest - deep moss greens and warm parchment text; low glow, soft corners.
# Measured with the WCAG formula in docs/THEMES.md:
#   body text 15.18:1 on window_bg, dim text 7.81:1, accent 9.39:1.
name          = Forest
dark          = 1
bg_top        = #07110A
bg_bottom     = #122A1A
accent        = #E0B36B
glow          = #2F5D3A
glow_strength = 0.35
panel         = #A6122317
panel_border  = #2E9CCB9A
text          = #F1EAD9
text_dim      = #9EAF94
window_bg     = #0C1810
window_border = #33A8C79A
corner        = 20
blur          = 1.0

# Icon animation: anim_speed is a pulse multiplier (0 = a still desktop,
# sensible range 0..3); icon_accent is the highlight colour inside every icon.
icon_accent   = #A8D5A2
anim_speed    = 0.45

# Icon geometry, motion and type. anim is one of none/pulse/glow/drift/orbit/
# wave/spin; icon_style one of solid/outline/duotone/rounded/sharp/pixel;
# font_scale (0.8..1.6) multiplies the user text scale.
anim          = drift
anim_amp      = 0.5
icon_style    = outline
font_ui       = Lato
font_mono     = JetBrains Mono
font_scale    = 1.0
