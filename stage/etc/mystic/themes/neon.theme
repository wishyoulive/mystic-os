# Neon - near-black glass for a dark room, with saturated cyan and magenta.
# Measured with the WCAG formula in docs/THEMES.md:
#   body text 19.30:1 on window_bg, dim text 6.98:1, accent 14.36:1.
name          = Neon
dark          = 1
bg_top        = #05040A
bg_bottom     = #0B0817
accent        = #22F0FF
glow          = #FF2BD6
glow_strength = 0.8
panel         = #A00A0916
panel_border  = #33A8F5FF
text          = #EAFEFF
text_dim      = #7E9DA8
window_bg     = #070610
window_border = #3AB8F7FF
corner        = 10
blur          = 1.0

# Icon animation: anim_speed is a pulse multiplier (0 = a still desktop,
# sensible range 0..3); icon_accent is the highlight colour inside every icon.
icon_accent   = #FF2BD6
anim_speed    = 1.6

# Icon geometry, motion and type. anim is one of none/pulse/glow/drift/orbit/
# wave/spin; icon_style one of solid/outline/duotone/rounded/sharp/pixel;
# font_scale (0.8..1.6) multiplies the user text scale.
anim          = glow
anim_amp      = 0.85
icon_style    = sharp
font_ui       = Lato
font_mono     = JetBrains Mono
font_scale    = 1.0
