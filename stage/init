#!/bin/sh
# ============================================================
#  Mystic OS - PID 1
#
#  Monts the pseudo-filesystems, loads the drivers we depend on,
#  then either shows the banner (normal) or reports facts and
#  powers off (probe).
#
#  probe mode exists so the build can verify the OS without a
#  human watching a screen:   ./image.sh probe
# ============================================================

/bin/mount -t proc     none /proc
/bin/mount -t sysfs    none /sys
/bin/mount -t devtmpfs none /dev
# pty support: without devpts forkpty() cannot open the slave side
mkdir -p /dev/pts
/bin/mount -t devpts none /dev/pts 2>/dev/null
/bin/hostname mystic
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
mkdir -p /root /run/mystic /tmp /var/log /dev/shm 2>/dev/null
# shared memory for the display protocol
/bin/mount -t tmpfs none /dev/shm 2>/dev/null

KV=$(uname -r)

# ------------------------------------------------------------
# Drivers. Alpine ships them as modules, so the first thing
# userspace does is load what we need. depmod reads our module
# tree and writes modules.dep, which modprobe then follows.
# ------------------------------------------------------------
load_modules() {
    [ -d "/lib/modules/$KV" ] || return 0
    depmod -a "$KV" 2>/dev/null
    for m in drm drm_kms_helper ttm drm_ttm_helper drm_vram_helper \
             drm_shmem_helper drm_client_lib fb_sys_fops sysimgblt sysfillrect \
             bochs virtio-gpu evdev psmouse              virtio_blk virtio_net net_failover failover af_packet crc16 mbcache jbd2 ext4 fat vfat nls_cp437 nls_iso8859-1; do
        modprobe "$m" 2>/dev/null
    done
}

# The disk is a real block device. On first boot it has no filesystem,
# so we make one - after that we just mount it. Everything in /root then
# survives a reboot, which is the difference between a demo and an OS.
# Bring up the first network interface and get a DHCP lease. Written only
# if an interface exists, so a machine without one still boots.
setup_net() {
    [ -d /sys/class/net/eth0 ] || { echo "net: no eth0"; return 0; }
    ip link set eth0 up 2>/dev/null
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i eth0 -q -n -t 4 -T 2 -s /etc/udhcpc.script >/dev/null 2>&1
    fi
    if ip -4 addr show eth0 2>/dev/null | grep -q "inet "; then
        echo "net: eth0 up, $(ip -4 addr show eth0 | awk '/inet /{print $2; exit}')"
    else
        echo "net: eth0 present but no lease"
    fi
}

# Settings live in the RAM rootfs, so a choice only lasts until reboot unless
# it is also written to the disk. Copy back anything found on /root.
restore_settings() {
    [ -d /root ] || return 0
    for f in ui.conf wallpaper current-theme; do
        if [ -f "/root/mystic-$f" ]; then
            cp "/root/mystic-$f" "/etc/mystic/$f" 2>/dev/null
        fi
    done
}

# Called by the desktop's helper path; also useful from a shell.
save_settings() {
    [ -d /root ] || return 1
    mkdir -p /root 2>/dev/null
    for f in ui.conf wallpaper current-theme; do
        [ -f "/etc/mystic/$f" ] && cp "/etc/mystic/$f" "/root/mystic-$f" 2>/dev/null
    done
    sync
}

setup_disk() {
    [ -b /dev/vda ] || { echo "disk: no /dev/vda"; return 0; }
    mkdir -p /root
    if mount -t ext4 /dev/vda /root 2>/dev/null; then
        echo "disk: mounted /dev/vda (ext4) on /root"
        return 0
    fi
    echo "disk: /dev/vda is unformatted, creating ext4 filesystem"
    if [ -x /sbin/mkfs.ext4 ]; then
        /sbin/mkfs.ext4 -q -F /dev/vda >/dev/null 2>&1
    else
        echo "disk: no mkfs.ext4 in the image"
    fi
    if mount -t ext4 /dev/vda /root 2>/dev/null; then
        chmod 755 /root
        echo "disk: formatted ext4 and mounted on /root"
    else
        echo "disk: could not mount"
    fi
}

probe() {
    echo "--- mystic probe ---"
    echo "kernel   : $(uname -r)"
    echo "uptime   : $(cut -d' ' -f1 /proc/uptime)s"
    echo "memory   : $(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo)"

    echo "modules  : $(awk '{print $1}' /proc/modules | tr '\n' ' ')"

    echo "graphics :"
    [ -e /dev/dri/card0 ] && echo "  card0: yes" || echo "  card0: no"
    [ -e /dev/fb0 ]       && echo "  fb0  : yes" || echo "  fb0  : no"
    for f in /sys/class/drm/card*/status; do
        [ -e "$f" ] && echo "  $(cat "$f"): $f"
    done
    for f in /sys/class/drm/card*/modes; do
        [ -e "$f" ] && echo "  modes: $(head -1 "$f")"
    done
    for f in /sys/class/graphics/*/name; do
        [ -e "$f" ] && echo "  fb name: $(cat "$f")"
    done

    echo "network  :"
    if [ -d /sys/class/net/eth0 ]; then
        echo "  link: $(cat /sys/class/net/eth0/operstate 2>/dev/null)"
        udhcpc -i eth0 -n -t 3 -T 2 -s /etc/udhcpc.script > /tmp/dhcp.log 2>&1
        echo "  udhcpc rc=$?"
        while read -r l; do echo "  | $l"; done < /tmp/dhcp.log
        ip addr show eth0 > /tmp/ip.log 2>&1
        # real internet, from inside the OS: DNS + TCP + HTTP
        if [ -x /usr/bin/wget ] || [ -x /bin/wget ]; then
            if wget -q -T 8 -O /tmp/net.html http://example.com 2>/tmp/net.err; then
                echo "  http: $(wc -c < /tmp/net.html) bytes from example.com"
            else
                echo "  http: failed - $(head -1 /tmp/net.err 2>/dev/null)"
            fi
        fi
        while read -r l; do echo "  > $l"; done < /tmp/ip.log
    else
        echo "  no eth0"
    fi

    echo "input    :"
    ls /dev/input 2>/dev/null | sed 's/^/  /' || echo "  none"
    for d in /sys/class/input/event*; do
        [ -e "$d/device/name" ] && echo "  $(cat "$d/device/name")"
    done

    if [ -d /root ] && mountpoint -q /root 2>/dev/null; then
        n=$(cat /root/boots.txt 2>/dev/null || echo 0)
        n=$((n + 1))
        echo "$n" > /root/boots.txt
        echo "disk     : mounted, boot counter now $n"
        touch /root/permtest
        chmod 600 /root/permtest
        chown 1000:1000 /root/permtest 2>/dev/null
        echo "perms    : $(ls -l /root/permtest | tr -s ' ' | cut -d' ' -f1,3,4)"
        echo "          files: $(ls /root | tr '
' ' ')"
        sync
    else
        echo "disk     : NOT mounted"
    fi

    echo "--- end probe ---"
}

load_modules
setup_net
setup_disk
restore_settings

if grep -q 'mystic.probe=1' /proc/cmdline; then
    probe
    sync
    poweroff -f
    while true; do sleep 1; done
fi

# If there is a screen, start the desktop. Otherwise drop to a shell
# (this is what a headless probe boot does).
if [ -x /usr/bin/mystic-desktop ] && [ -e /dev/fb0 ]; then
    # Unbind the kernel's framebuffer console first. It keeps painting its
    # text cursor on top of whatever we draw, so it has to go before the
    # desktop takes the screen.
    for v in /sys/class/vtconsole/vtcon*; do
        [ -e "$v/name" ] || continue
        case "$(cat "$v/name")" in
            *frame\ buffer*) [ -e "$v/bind" ] && echo 0 > "$v/bind" 2>/dev/null ;;
        esac
    done
    echo "starting mystic-desktop"
    exec /usr/bin/mystic-desktop
fi

clear 2>/dev/null
echo
cat /etc/mystic-banner
echo
echo "  kernel : $(uname -r)"
echo "  memory : $(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo) visible to the OS"
echo "  display: $([ -e /dev/dri/card0 ] && echo card0 || echo none)"
echo
exec /bin/sh
