#!/bin/sh
# ============================================================
#  Mystic OS - PID 1
#
#  Monts the pseudo-filesystems, loads the drivers we depend on,
#  then either shows the banner (normal) or reports facts and
#  powers off (probe).
#
#  probe mode exists so the build can verify the OS without a
#  human watching a screen:   ./image.sh probe
#
#  /dev/vda is either a dm-crypt volume with ext4 inside it
#  (docs/ENCRYPTION.md, tools/mkenc.sh) or a plain ext4 made by
#  an older build. Both boot; the messages say which one it is.
#
#  The key has two halves and one of them is never on the disk:
#    boot half  /etc/mystic/luks.key, or sealed under the boot
#               passphrase as /etc/mystic/luks.key.sealed
#    disk half  inside the MYSTICC1 header on the disk itself
#  Neither half opens anything alone. Sealing the boot half makes
#  the boot ask for the lock-screen password before /root is
#  mounted; docs/ENCRYPTION.md section 6 says what that is worth.
# ============================================================

# ------------------------------------------------------------
# Pseudo-filesystems. Separated from the boot body so the disk
# logic below can be sourced by tools/mkenc.sh's simulation
# without mounting anything on the build machine.
# ------------------------------------------------------------
mount_pseudo() {
    /bin/mount -t proc     none /proc
    /bin/mount -t sysfs    none /sys
    /bin/mount -t devtmpfs none /dev
    # pty support: without devpts forkpty() cannot open the slave side
    mkdir -p /dev/pts
    /bin/mount -t devpts none /dev/pts 2>/dev/null
    /bin/hostname mystic
    export PATH=/sbin:/usr/sbin:/bin:/usr/bin
    mkdir -p /root /run/mystic /tmp /var/log /dev/shm 2>/dev/null
    # shared memory for the display protocol
    /bin/mount -t tmpfs none /dev/shm 2>/dev/null
}

# ------------------------------------------------------------
# Drivers. Alpine ships them as modules, so the first thing
# userspace does is load what we need. depmod reads our module
# tree and writes modules.dep, which modprobe then follows.
# ------------------------------------------------------------
load_modules() {
    [ -d "/lib/modules/$KV" ] || return 0
    depmod -a "$KV" 2>/dev/null
    for m in drm drm_kms_helper ttm drm_ttm_helper drm_vram_helper \
             drm_shmem_helper drm_client_lib fb_sys_fops sysimgblt sysfillrect \
             bochs virtio-gpu evdev psmouse              virtio_blk virtio_net net_failover failover af_packet crc16 mbcache jbd2 ext4 fat vfat nls_cp437 nls_iso8859-1 \
             snd snd-pcm snd-timer snd-hda-intel snd-hda-codec snd-hda-codec-generic soundcore; do
        modprobe "$m" 2>/dev/null
    done
    # Audio: say whether a card appeared, because "no sound" with no message is
    # the worst possible outcome.
    if [ -r /proc/asound/cards ]; then
        cards=$(grep -c '^ *[0-9]' /proc/asound/cards 2>/dev/null)
        pcm=$(ls /dev/snd/ 2>/dev/null | grep -c '^pcmC')
        echo "sound: $cards card(s), $pcm pcm device(s)"
        grep -E '^ *[0-9]' /proc/asound/cards 2>/dev/null | head -2 | sed 's/^/sound: /' 
        # devtmpfs makes the PCM nodes 0600 root:root: there is no udev here
        # to apply the usual 0660 root:audio. The window server's app jail
        # runs as uid 1000, so without this the Clock's alarm opens
        # /dev/snd/pcmC0D0p and gets EACCES even though the card is there.
        # Playback nodes only (names end in 'p'); capture stays root-only.
        for node in /dev/snd/pcmC*D*p; do
            [ -c "$node" ] || continue
            oldmode=$(ls -ld "$node" 2>/dev/null | cut -d' ' -f1)
            if chmod 0666 "$node" 2>/dev/null; then
                echo "sound: playback open to apps: $node (was $oldmode)"
            else
                echo "sound: cannot chmod $node (was $oldmode)"
            fi
        done
    else
        echo "sound: no /proc/asound - kernel sound support not loaded"
    fi
    for m in unused; do
        :
    done
}

setup_net() {
    [ -d /sys/class/net/eth0 ] || { echo "net: no eth0"; return 0; }
    ip link set eth0 up 2>/dev/null
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i eth0 -q -n -t 4 -T 2 -s /etc/udhcpc.script >/dev/null 2>&1
    fi
    if ip -4 addr show eth0 2>/dev/null | grep -q "inet "; then
        echo "net: eth0 up, $(ip -4 addr show eth0 | awk '/inet /{print $2; exit}')"
    else
        echo "net: eth0 present but no lease"
    fi
}

# Settings live in the RAM rootfs, so a choice only lasts until reboot unless
# it is also written to the disk. Copy back anything found on /root.
restore_settings() {
    [ -d /root ] || return 0
    for f in ui.conf wallpaper current-theme; do
        if [ -f "/root/mystic-$f" ]; then
            cp "/root/mystic-$f" "/etc/mystic/$f" 2>/dev/null
        fi
    done
}

# Called by the desktop's helper path; also useful from a shell.
save_settings() {
    [ -d /root ] || return 1
    mkdir -p /root 2>/dev/null
    for f in ui.conf wallpaper current-theme; do
        [ -f "/etc/mystic/$f" ] && cp "/etc/mystic/$f" "/root/mystic-$f" 2>/dev/null
    done
    sync
}

# ============================================================
#  Disk: dm-crypt + ext4
#
#  The kernel side is CONFIG_BLK_DEV_DM=m + CONFIG_DM_CRYPT=m
#  (verified in build/cache/linux-virt-*/boot/config-*), with
#  aes and xts built in, so no crypto module is needed. The
#  userspace side is stage/sbin/mystic-dmcrypt, a static musl
#  binary that speaks the dm-ioctl ABI directly - no dmsetup,
#  no libdevmapper, no libcryptsetup. tools/mkenc.sh builds it,
#  stages the two modules, creates the key and can seal it with
#  the lock-screen passphrase.
#
#  Nothing below invents a fact: every branch either reads a
#  header written by mystic-dmcrypt or takes the same path this
#  script took before encryption existed.
# ============================================================
CRYPT_DEV=${MYSTIC_DISK:-/dev/vda}
CRYPT_NAME=${MYSTIC_MAP:-mystic-root}
CRYPT_KEY=${MYSTIC_KEY:-/etc/mystic/luks.key}
# The sealed form of the same 32 bytes: PBKDF2-HMAC-SHA256(passphrase) ->
# ChaCha20 + HMAC-SHA256 (tools/mkenc.sh seal). When this file exists and
# the plaintext key does not, the boot asks for the passphrase before /root
# is mounted and keeps the opened key in RAM only.
CRYPT_SEAL=${MYSTIC_SEAL:-/etc/mystic/luks.key.sealed}
CRYPT_RAMKEY=${MYSTIC_RAMKEY:-/run/mystic/luks.key}
CRYPT_CONSOLE=${MYSTIC_CONSOLE:-/dev/console}
CRYPT_CMDLINE=${MYSTIC_CMDLINE:-/proc/cmdline}
CRYPT_PASSWD=${MYSTIC_PASSWD:-/etc/mystic/passwd}
CRYPT_KEY_USE=$CRYPT_KEY
CRYPT_HELPER=${MYSTIC_DMCRYPT:-/sbin/mystic-dmcrypt}
CRYPT_MAP=${MYSTIC_MAP_PATH:-/dev/mapper/$CRYPT_NAME}
DM_CONTROL=${MYSTIC_DM_CONTROL:-/dev/mapper/control}
MKFS=${MYSTIC_MKFS:-/sbin/mkfs.ext4}
CRYPT_LOG=${MYSTIC_CRYPT_LOG:-/tmp/crypt.log}
CRYPT_STATUS=none

disk_present() { [ -b "$CRYPT_DEV" ]; }

# ------------------------------------------------------------
# These read the device with dd/tr/cksum and need no helper, no
# module and no root privilege. They exist so that a disk which
# carries our header is refused even when mystic-dmcrypt is
# missing from the image (a git clean removes stage/sbin/), and so
# that a filesystem inside the mapping is never formatted because
# a mount happened to fail.
#
# No od(1) here on purpose: its -j/-N/-v extensions are not
# guaranteed by a busybox build, and these run on the target.
# ------------------------------------------------------------
dev_has_header() {   # "MYSTICC1" in the first 8 bytes
    # tr maps anything non-printable to '.', so a blank device reads as
    # "........" instead of eight NULs (which bash would warn about).
    m=$(dd if="$1" bs=8 count=1 2>/dev/null | tr -c '[:print:]' '.')
    [ "$m" = "MYSTICC1" ]
}

dev_is_blank() {     # the first 4 KiB is zero: a device nothing has written
    # cksum, not od: exact, and the same answer for a 4096-byte zero block
    # whichever busybox this is.
    zerosum=$(dd if=/dev/zero bs=4096 count=1 2>/dev/null | cksum)
    [ -n "$zerosum" ] || return 1        # /dev/zero unreadable: never call it blank
    [ "$(dd if="$1" bs=4096 count=1 2>/dev/null | cksum)" = "$zerosum" ]
}

dev_has_ext4() {     # ext2/3/4 superblock magic 0x53EF at byte 1080
    # Byte 1080 is 'S' (0x53) and byte 1081 is 0xEF, which is not printable.
    # A real ext4 therefore always matches; a ciphertext byte that happens to
    # be 'S' can only make this say "yes", and "yes" means the caller refuses
    # to format. There is no way for a real ext4 to be missed.
    # Both bytes go through tr so that a NUL at 1080 does not make the shell
    # print "ignored null byte in input" on the boot console.
    a=$(dd if="$1" bs=1 skip=1080 count=1 2>/dev/null | tr -c '[:print:]' '.')
    b=$(dd if="$1" bs=1 skip=1081 count=1 2>/dev/null | tr -c '[:print:]' '.')
    [ "$a" = "S" ] && [ "$b" = "." ]
}

# one of: header | blank | other - the three answers that matter when
# the helper is not in the image
dev_probe_shell() {
    dev_has_header "$CRYPT_DEV" && { echo header; return 0; }
    dev_is_blank "$CRYPT_DEV"   && { echo blank; return 0; }
    echo other
}

# ext4 in the image is the only mkfs we have. $MYSTIC_MKFS exists so
mkfs_ext4() {
    [ -x "$MKFS" ] || { echo "disk: no mkfs.ext4 in the image"; return 1; }
    "$MKFS" -q -F "$1" >/dev/null 2>&1
}

# dm_mod creates /dev/mapper/control when it registers; devtmpfs normally
# creates the node itself, but a module loaded before devtmpfs would not.
crypt_modules() {
    # dm-mod.ko is the file, dm_mod the module: busybox modprobe accepts
    # either spelling, and this script does not get to pick which one.
    if command -v modprobe >/dev/null 2>&1; then
        modprobe dm-mod 2>/dev/null || modprobe dm_mod 2>/dev/null
        modprobe dm-crypt 2>/dev/null || modprobe dm_crypt 2>/dev/null
    fi
    [ -e "$DM_CONTROL" ] && return 0
    [ -d "$(dirname "$DM_CONTROL")" ] || mkdir -p "$(dirname "$DM_CONTROL")" 2>/dev/null
    [ -e "$DM_CONTROL" ]
}

# ------------------------------------------------------------
# Which key opens the disk, and can it be obtained right now?
#
#   0  a 32-byte key is ready, $CRYPT_KEY_USE points at it
#   1  there is no key at all: nothing to encrypt with, nothing to lose
#   2  a key exists but cannot be reached now (no console, no helper,
#      probe mode, unreadable file)
#   3  the passphrase was refused (three attempts) or the seal is damaged
#
# Two forms are accepted, in this order:
#   /etc/mystic/luks.key         the boot half in the clear (unattended boot)
#   /etc/mystic/luks.key.sealed  the same 32 bytes under a passphrase-derived
#                                key; unsealed into RAM for this boot only
# The disk itself is never consulted for this: it holds only the *other*
# half of the key material, inside the MYSTICC1 header.
# ------------------------------------------------------------
crypt_key_ready() {
    # Crypt_create() and crypt_mount() both ask. Re-resolving is pointless (and
    # on a sealed image would mean a second passphrase prompt), so a key that
    # is already ready for this boot is reused.
    if [ "${CRYPT_KEY_OK:-0}" = 1 ] && [ -f "$CRYPT_KEY_USE" ]; then
        [ "$CRYPT_KEY_USE" = "$CRYPT_RAMKEY" ] \
            && echo "key: $CRYPT_KEY_USE (unsealed earlier in this boot)"
        return 0
    fi
    CRYPT_KEY_USE=$CRYPT_KEY
    CRYPT_KEY_OK=0
    if [ -e "$CRYPT_KEY" ]; then
        size=$(wc -c < "$CRYPT_KEY" 2>/dev/null | tr -d ' ')
        if [ "$size" = 32 ]; then
            echo "key: $CRYPT_KEY (32 bytes, not sealed)"
            CRYPT_KEY_OK=1
            return 0
        fi
        echo "disk: $CRYPT_KEY is ${size:-0} bytes, not 32 - refusing to use it"
        return 2
    fi
    if [ ! -e "$CRYPT_SEAL" ]; then
        echo "disk: no key at $CRYPT_KEY and no sealed key at $CRYPT_SEAL"
        return 1
    fi
    if [ ! -e "$CRYPT_CONSOLE" ]; then
        echo "disk: $CRYPT_SEAL needs the passphrase, and there is no console at $CRYPT_CONSOLE"
        return 2
    fi
    # probe mode exists to report facts without a human at the keyboard; a
    # blocking read there would hang the boot until the outer timeout kills it.
    if [ -r "$CRYPT_CMDLINE" ] && grep -q 'mystic.probe=1' "$CRYPT_CMDLINE" 2>/dev/null; then
        echo "disk: $CRYPT_SEAL needs the passphrase; probe mode does not prompt"
        return 2
    fi
    if [ ! -x "$CRYPT_HELPER" ]; then
        echo "disk: $CRYPT_SEAL needs $CRYPT_HELPER to be unsealed, and it is not in the image"
        return 2
    fi
    mkdir -p "$(dirname "$CRYPT_RAMKEY")" 2>/dev/null
    tries=0
    while [ "$tries" -lt 3 ]; do
        tries=$((tries + 1))
        "$CRYPT_HELPER" unseal "$CRYPT_SEAL" "$CRYPT_RAMKEY" \
            --prompt --console "$CRYPT_CONSOLE" --passwd-file "$CRYPT_PASSWD"
        us_rc=$?
        case "$us_rc" in
            0)  CRYPT_KEY_USE=$CRYPT_RAMKEY
                CRYPT_KEY_OK=1
                echo "key: unsealed $CRYPT_SEAL into $CRYPT_RAMKEY (RAM only)"
                return 0 ;;
            5)  # the seal's HMAC failed: either a damaged seal or a typo
                echo "disk: the sealed key did not decrypt (attempt $tries of 3)" ;;
            6)  echo "disk: $CRYPT_SEAL is not a sealed key - it is left untouched"
                return 3 ;;
            7)  echo "disk: no passphrase could be read (attempt $tries of 3)" ;;
            8)  echo "disk: that is not the lock-screen password (attempt $tries of 3)" ;;
            *)  echo "disk: $CRYPT_HELPER unseal failed with exit $us_rc"
                return 2 ;;
        esac
    done
    echo "disk: giving up after 3 attempts - the volume stays locked"
    return 3
}

# The opened key only needs to exist until dm-crypt has it. Overwrite it and
# unlink: an initramfs/ramfs keeps the blocks in RAM, so this shortens the
# window in which a stray read of the rootfs finds the key. It does not, and
# cannot, remove the key from the kernel's dm-crypt state.
crypt_key_wipe() {
    [ "$CRYPT_KEY_USE" = "$CRYPT_RAMKEY" ] || return 0
    [ -f "$CRYPT_RAMKEY" ] || return 0
    dd if=/dev/zero of="$CRYPT_RAMKEY" bs=32 count=1 conv=notrunc 2>/dev/null
    rm -f "$CRYPT_RAMKEY"
}

# prints one of:
#   "crypt <version> <fingerprint>"  our header, dm-crypt loaded, ready to open
#   "locked:<reason>"                our header, and it cannot be opened now
#   blank                            first 4 KiB is zero, nothing has used it
#   fs                               ext2/3/4 magic at 0x438, no header
#   keep:<reason>                    not blank, not ext4, not ours: do not guess
#   "unavailable:<reason>"           blank, but nothing could encrypt it
#   error                            the device could not be classified
#
# A device with a MYSTICC1 header NEVER reaches the plain path, whatever is
# missing: the shell check above runs even when the helper binary does not.
crypt_state() {
    if [ ! -x "$CRYPT_HELPER" ]; then
        case "$(dev_probe_shell)" in
            header)
                echo "locked:no $CRYPT_HELPER in the image, and $CRYPT_DEV carries a MYSTICC1 header" ;;
            blank)
                echo "unavailable:no $CRYPT_HELPER in the image" ;;
            *)
                # Not blank and not ours: without the helper this could be a
                # damaged header, so it is mounted if it mounts and otherwise
                # left alone. It is never formatted.
                echo "keep:no $CRYPT_HELPER in the image, and $CRYPT_DEV is not blank and carries no MYSTICC1 header" ;;
        esac
        return 0
    fi
    probe_out=$("$CRYPT_HELPER" probe "$CRYPT_DEV" 2>/dev/null)
    probe_rc=$?
    case "$probe_rc" in
        0)
            if crypt_modules; then
                echo "$probe_out"
            else
                echo "locked:dm_mod/dm_crypt did not load"
            fi
            ;;
        10)
            if crypt_modules; then
                echo blank
            else
                echo "unavailable:dm_mod/dm_crypt did not load"
            fi
            ;;
        11) echo fs ;;
        12)
            # the helper says: not blank, no filesystem magic, no header.
            # A damaged header reads exactly like this, so say so and stop.
            echo "keep:$CRYPT_DEV is not blank, not ext4 and carries no MYSTICC1 header" ;;
        *)
            # the helper failed to read or to understand the header. The shell
            # check decides whether a volume is at stake, never the exit code.
            if dev_has_header "$CRYPT_DEV"; then
                echo "locked:the probe failed, and $CRYPT_DEV carries a MYSTICC1 header"
            elif dev_has_ext4 "$CRYPT_DEV"; then
                echo fs
            else
                echo "keep:the probe failed and $CRYPT_DEV is not blank"
            fi
            ;;
    esac
}

show_log() {   # show_log <indent> < file
    while read -r line; do
        [ -n "$line" ] && echo "$1$line"
    done
}

# Open an existing volume and mount it. $1 is the header fingerprint.
crypt_mount() {
    # Get the key first: the disk half lives in the header, the other half is
    # in the initramfs in the clear or sealed under the boot passphrase. A
    # locked key must not be reported as a broken disk.
    crypt_key_ready
    krc=$?
    if [ "$krc" -ne 0 ]; then
        case "$krc" in
            1) CRYPT_STATUS="locked (no key)" ;;
            3) CRYPT_STATUS="locked (passphrase refused)" ;;
            *) CRYPT_STATUS="locked (no usable key)" ;;
        esac
        echo "disk: refusing to touch $CRYPT_DEV, /root stays on the RAM filesystem"
        return 1
    fi
    # mystic-dmcrypt says which class of failure this was: 2 = the key file is
    # missing or the wrong length, 3 = the key does not match the header,
    # 4 = the device mapper refused (no /dev/mapper/control, ioctl, mknod).
    # Without that, every first-boot dm failure would be reported as a wrong
    # key and send the owner looking for a new key instead of a module.
    "$CRYPT_HELPER" attach "$CRYPT_NAME" "$CRYPT_DEV" "$CRYPT_KEY_USE" >"$CRYPT_LOG" 2>&1
    attach_rc=$?
    if [ "$attach_rc" -ne 0 ]; then
        case "$attach_rc" in
            2)  echo "disk: cannot read the boot key $CRYPT_KEY_USE - $CRYPT_DEV is left untouched"
                CRYPT_STATUS="locked (no usable key)" ;;
            3)  echo "disk: encrypted, but the key did not unlock it - $CRYPT_DEV is left untouched"
                CRYPT_STATUS="locked (key does not match)" ;;
            4)  echo "disk: dm-crypt could not create the mapping - $CRYPT_DEV is left untouched"
                CRYPT_STATUS="locked (dm-crypt error)" ;;
            *)  echo "disk: mystic-dmcrypt could not open $CRYPT_DEV - it is left untouched"
                CRYPT_STATUS="locked (helper error)" ;;
        esac
        show_log "  " < "$CRYPT_LOG"
        crypt_key_wipe
        return 1
    fi
    show_log "crypt: " < "$CRYPT_LOG"
    # dm-crypt holds the key from here on; the file is no longer needed.
    crypt_key_wipe
    if mount -t ext4 "$CRYPT_MAP" /root 2>/dev/null; then
        echo "disk: dm-crypt unlocked, formatted ext4 mounted on /root"
        echo "crypt: aes-xts-plain64, key fingerprint $1"
        CRYPT_STATUS="aes-xts-plain64, key $1"
        return 0
    fi
    # A failed mount is not proof that there is no filesystem. Two
    # independent pieces of evidence are checked before anything is written:
    # the ext2/3/4 magic at byte 1080 inside the mapping, and the marker the
    # helper wrote into the header after the last successful mkfs.
    if dev_has_ext4 "$CRYPT_MAP"; then
        echo "disk: dm-crypt unlocked, ext4 is there but did not mount - refusing to format it"
        echo "disk: nothing was written; the volume is intact"
        CRYPT_STATUS="unlocked, ext4 present but not mounted"
        return 1
    fi
    "$CRYPT_HELPER" hasfs "$CRYPT_DEV" >/dev/null 2>&1
    if [ $? -eq 0 ]; then
        echo "disk: dm-crypt unlocked, no ext4 magic, but its header records that a"
        echo "disk: filesystem was created in it once - refusing to format it"
        echo "disk: nothing was written; the volume is intact"
        CRYPT_STATUS="unlocked, filesystem recorded but not mounted"
        return 1
    fi
    echo "disk: dm-crypt unlocked, no filesystem inside - creating one"
    if ! mkfs_ext4 "$CRYPT_MAP"; then
        echo "disk: mkfs.ext4 failed inside the mapping - nothing is mounted"
        CRYPT_STATUS="unlocked, mkfs failed"
        return 1
    fi
    if mount -t ext4 "$CRYPT_MAP" /root 2>/dev/null; then
        chmod 755 /root
        # Record it in the header, so that a later boot can never mistake this
        # volume for one that was never formatted.
        if "$CRYPT_HELPER" markfs "$CRYPT_DEV" >"$CRYPT_LOG" 2>&1; then
            show_log "crypt: " < "$CRYPT_LOG"
        else
            echo "disk: warning: could not record the filesystem in the header"
            show_log "  " < "$CRYPT_LOG"
        fi
        echo "disk: formatted ext4 inside dm-crypt and mounted on /root"
        echo "crypt: aes-xts-plain64, key fingerprint $1"
        CRYPT_STATUS="aes-xts-plain64, key $1"
        return 0
    fi
    echo "disk: could not mount the dm-crypt volume"
    CRYPT_STATUS="unlocked but not mounted"
    return 1
}

# First boot: write the MYSTICC1 header, then open it. Only ever called on a
# device whose first 4 KiB is zero, so no data can be lost here.
crypt_create() {
    crypt_key_ready
    krc=$?
    if [ "$krc" -eq 1 ]; then
        # No key anywhere: this image was built without ./tools/mkenc.sh. The
        # pre-encryption boot path stays available, but it says out loud that
        # the result is not encrypted.
        echo "disk: this image has no boot key, so $CRYPT_DEV stays UNENCRYPTED"
        echo "disk: run ./tools/mkenc.sh seal (or plain mkenc.sh) and rebuild the image"
        setup_plain_disk format
        return 0
    fi
    if [ "$krc" -ne 0 ]; then
        # A key exists but cannot be used now. Creating a plain fallback here
        # would silently hand the owner an unencrypted disk; refuse instead.
        echo "disk: cannot create the encrypted volume without the key - $CRYPT_DEV is left untouched"
        case "$krc" in
            3) CRYPT_STATUS="locked (passphrase refused)" ;;
            *) CRYPT_STATUS="locked (no usable key)" ;;
        esac
        return 1
    fi
    if ! "$CRYPT_HELPER" init "$CRYPT_DEV" "$CRYPT_KEY_USE" >"$CRYPT_LOG" 2>&1; then
        echo "disk: could not create the encrypted volume - $CRYPT_DEV is left untouched"
        show_log "  " < "$CRYPT_LOG"
        # init writes the header before anything else. If it got that far, the
        # disk is an encrypted volume now and must never see a plain mkfs.
        if dev_has_header "$CRYPT_DEV"; then
            echo "disk: the MYSTICC1 header is on the disk; it will not be formatted"
            CRYPT_STATUS="not created (header written, mapping failed)"
        else
            CRYPT_STATUS="not created (see the log above)"
        fi
        crypt_key_wipe
        return 1
    fi
    show_log "crypt: " < "$CRYPT_LOG"
    echo "disk: created dm-crypt volume on $CRYPT_DEV (aes-xts-plain64)"
    probe_out=$("$CRYPT_HELPER" probe "$CRYPT_DEV" 2>/dev/null)
    crypt_mount "${probe_out##* }"
}

# A plain ext4 disk, the pre-encryption path. Formatting is allowed ONLY when
# the device provably holds no filesystem: no MYSTICC1 header, no ext2/3/4
# magic and a zeroed first 4 KiB. "The mount failed" is not that proof.
# $1 = format (a blank disk may be formatted) or keep (never format).
setup_plain_disk() {
    if mount -t ext4 "$CRYPT_DEV" /root 2>/dev/null; then
        echo "disk: mounted $CRYPT_DEV (ext4) on /root"
        CRYPT_STATUS="none (plain ext4)"
        return 0
    fi
    if dev_has_header "$CRYPT_DEV"; then
        echo "disk: $CRYPT_DEV carries a MYSTICC1 header - refusing to format it"
        echo "disk: nothing was written; /root stays on the RAM filesystem"
        CRYPT_STATUS="locked (header present, not opened)"
        return 1
    fi
    if dev_has_ext4 "$CRYPT_DEV"; then
        echo "disk: $CRYPT_DEV has an ext4 superblock but did not mount - refusing to format it"
        echo "disk: run e2fsck -y on it, or ./tools/mkenc.sh reset-disk for a fresh disk"
        CRYPT_STATUS="present but not mountable (left untouched)"
        return 1
    fi
    if [ "${1:-format}" != format ] || ! dev_is_blank "$CRYPT_DEV"; then
        echo "disk: $CRYPT_DEV did not mount and is not blank - refusing to format it"
        echo "disk: nothing was written; delete build/disk.img (or run"
        echo "disk: ./tools/mkenc.sh reset-disk) if you want a fresh disk"
        CRYPT_STATUS="present but not mountable (left untouched)"
        return 1
    fi
    echo "disk: $CRYPT_DEV is blank - creating ext4 filesystem"
    # -F is explicit: format even if a stale signature is still visible to
    # mkfs, which the three checks above have already ruled out.
    if ! mkfs_ext4 "$CRYPT_DEV"; then
        echo "disk: mkfs.ext4 failed on $CRYPT_DEV - nothing is mounted"
        CRYPT_STATUS="blank (mkfs failed)"
        return 1
    fi
    if mount -t ext4 "$CRYPT_DEV" /root 2>/dev/null; then
        chmod 755 /root
        echo "disk: formatted ext4 and mounted on /root"
        CRYPT_STATUS="none (plain ext4)"
        return 0
    fi
    echo "disk: could not mount"
    return 1
}

setup_disk() {
    disk_present || { echo "disk: no $CRYPT_DEV"; return 0; }
    mkdir -p /root

    crypt_state_out=$(crypt_state)
    case "$crypt_state_out" in
        crypt*)
            crypt_mount "${crypt_state_out##* }"
            return 0
            ;;
        locked:*)
            # The header is there, so the data is encrypted. Formatting here
            # would destroy it; leaving /root unmounted keeps the system up.
            echo "disk: $CRYPT_DEV is encrypted but cannot be opened - ${crypt_state_out#locked:}"
            echo "disk: refusing to format it, /root stays on the RAM filesystem"
            CRYPT_STATUS="locked (${crypt_state_out#locked:})"
            return 0
            ;;
        blank)
            crypt_create
            return 0
            ;;
        fs)
            # an ext2/3/4 disk from before encryption, or made by hand
            echo "disk: $CRYPT_DEV has no encryption header, so it is not encrypted"
            setup_plain_disk format
            return 0
            ;;
        keep:*)
            echo "disk: ${crypt_state_out#keep:}"
            setup_plain_disk keep
            return 0
            ;;
        unavailable:*)
            # blank disk, nothing to encrypt it with: format it plain, as before,
            # and say that the result is not encrypted.
            echo "disk: dm-crypt unavailable - ${crypt_state_out#unavailable:}"
            echo "disk: $CRYPT_DEV is blank, so this creates an UNENCRYPTED /root"
            setup_plain_disk format
            return 0
            ;;
        *)
            echo "disk: could not read $CRYPT_DEV"
            setup_plain_disk keep
            return 0
            ;;
    esac
}

probe() {
    echo "--- mystic probe ---"
    echo "kernel   : $(uname -r)"
    echo "uptime   : $(cut -d' ' -f1 /proc/uptime)s"
    echo "memory   : $(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo)"
    echo "crypt    : $CRYPT_STATUS"

    echo "modules  : $(awk '{print $1}' /proc/modules | tr '\n' ' ')"

    echo "graphics :"
    [ -e /dev/dri/card0 ] && echo "  card0: yes" || echo "  card0: no"
    [ -e /dev/fb0 ]       && echo "  fb0  : yes" || echo "  fb0  : no"
    for f in /sys/class/drm/card*/status; do
        [ -e "$f" ] && echo "  $(cat "$f"): $f"
    done
    for f in /sys/class/drm/card*/modes; do
        [ -e "$f" ] && echo "  modes: $(head -1 "$f")"
    done
    for f in /sys/class/graphics/*/name; do
        [ -e "$f" ] && echo "  fb name: $(cat "$f")"
    done

    echo "network  :"
    if [ -d /sys/class/net/eth0 ]; then
        echo "  link: $(cat /sys/class/net/eth0/operstate 2>/dev/null)"
        udhcpc -i eth0 -n -t 3 -T 2 -s /etc/udhcpc.script > /tmp/dhcp.log 2>&1
        echo "  udhcpc rc=$?"
        while read -r l; do echo "  | $l"; done < /tmp/dhcp.log
        ip addr show eth0 > /tmp/ip.log 2>&1
        # real internet, from inside the OS: DNS + TCP + HTTP
        if [ -x /usr/bin/wget ] || [ -x /bin/wget ]; then
            if wget -q -T 8 -O /tmp/net.html http://example.com 2>/tmp/net.err; then
                echo "  http: $(wc -c < /tmp/net.html) bytes from example.com"
            else
                echo "  http: failed - $(head -1 /tmp/net.err 2>/dev/null)"
            fi
        fi
        while read -r l; do echo "  > $l"; done < /tmp/ip.log
    else
        echo "  no eth0"
    fi

    echo "input    :"
    ls /dev/input 2>/dev/null | sed 's/^/  /' || echo "  none"
    for d in /sys/class/input/event*; do
        [ -e "$d/device/name" ] && echo "  $(cat "$d/device/name")"
    done

    if [ -d /root ] && mountpoint -q /root 2>/dev/null; then
        n=$(cat /root/boots.txt 2>/dev/null || echo 0)
        n=$((n + 1))
        echo "$n" > /root/boots.txt
        echo "disk     : mounted, boot counter now $n"
        touch /root/permtest
        chmod 600 /root/permtest
        chown 1000:1000 /root/permtest 2>/dev/null
        echo "perms    : $(ls -l /root/permtest | tr -s ' ' | cut -d' ' -f1,3,4)"
        echo "          files: $(ls /root | tr '
' ' ')"
        sync
    else
        echo "disk     : NOT mounted"
    fi

    echo "--- end probe ---"
}

# ============================================================
#  Boot. Everything below runs only when this file is PID 1.
#  tools/mkenc.sh sources it with MYSTIC_INIT_LIB=1 to exercise
#  the disk branches against a fake /dev, a fake mount and a
#  host build of mystic-dmcrypt (see ./tools/mkenc.sh test).
# ============================================================
if [ "${MYSTIC_INIT_LIB:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

KV=$(uname -r)
mount_pseudo
load_modules
setup_net
setup_disk
restore_settings

if grep -q 'mystic.probe=1' /proc/cmdline; then
    probe
    sync
    poweroff -f
    while true; do sleep 1; done
fi

# If there is a screen, start the desktop. Otherwise drop to a shell
# (this is what a headless probe boot does).
if [ -x /usr/bin/mystic-desktop ] && [ -e /dev/fb0 ]; then
    # Clipboard: the daemon owns /root/clipboard and the socket every copy
    # and paste goes through. Start it BEFORE the desktop so the first
    # Ctrl+V already has somewhere to go; clipd takes an flock on
    # /root/clipboard/clipd.lock, so a second instance exits by itself
    # instead of corrupting the store. Both spellings are the same code:
    # the standalone binary if the image carries one, otherwise the
    # desktop's own --clipd entry point.
    if [ -x /usr/bin/mystic-clipboardd ]; then
        /usr/bin/mystic-clipboardd &
        echo "clipboard: started /usr/bin/mystic-clipboardd"
    else
        /usr/bin/mystic-desktop --clipd &
        echo "clipboard: started mystic-desktop --clipd"
    fi
    tries=0
    while [ ! -S /run/mystic/clipboard.sock ] && [ "$tries" -lt 20 ]; do
        sleep 0.05
        tries=$((tries + 1))
    done
    if [ -S /run/mystic/clipboard.sock ]; then
        echo "clipboard: ready on /run/mystic/clipboard.sock"
    else
        echo "clipboard: daemon did not open its socket; the desktop will host it"
    fi

    # Unbind the kernel's framebuffer console first. It keeps painting its
    # text cursor on top of whatever we draw, so it has to go before the
    # desktop takes the screen.
    for v in /sys/class/vtconsole/vtcon*; do
        [ -e "$v/name" ] || continue
        case "$(cat "$v/name")" in
            *frame\ buffer*) [ -e "$v/bind" ] && echo 0 > "$v/bind" 2>/dev/null ;;
        esac
    done
    echo "starting mystic-desktop"
    exec /usr/bin/mystic-desktop
fi

clear 2>/dev/null
echo
cat /etc/mystic-banner
echo
echo "  kernel : $(uname -r)"
echo "  memory : $(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo) visible to the OS"
echo "  display: $([ -e /dev/dri/card0 ] && echo card0 || echo none)"
echo
exec /bin/sh
