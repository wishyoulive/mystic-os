#!/bin/sh
# Reproduce the jail's interpreter path outside the jail: /app/ld-musl-... is
# what the package writes into PT_INTERP, and the bundle is mounted at /app
# inside the jail. Here /app is a symlink to the same loader.
B=/root/apps/engine
mkdir -p /app
ln -sf "$B/ld-musl-x86_64.so.1" /app/ld-musl-x86_64.so.1
export LD_LIBRARY_PATH="$B/usr/lib"
"$B/usr/lib/chromium/chromium-headless-shell" --headless --no-sandbox \
    --disable-gpu --dump-dom about:blank
echo "EXIT=$?"
