build/
*.img
*.iso
*.bin
*.o
*.elf
*.ppm
*.png
# ...except the screenshots the README embeds: they are documentation,
# not build output, and ignoring them is why the README showed broken images.
!docs/screenshots/*.png
.DS_Store

# needs the workflow OAuth scope to push: gh auth refresh -s workflow
.github/workflows/
# build outputs: never commit binaries or downloaded modules
stage/usr/bin/mystic-desktop
stage/usr/bin/ed25519-verify
stage/usr/share/mystic/apps/*/bin
stage/lib/modules/
stage/usr/share/fonts/*.ttf
stage/sbin/
stage/usr/lib/

# agent scratch space
.work/
