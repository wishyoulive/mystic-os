build/
*.img
*.iso
*.bin
*.o
*.elf
*.ppm
*.png
# ...except the screenshots the README embeds: they are documentation,
# not build output, and ignoring them is why the README showed broken images.
!docs/screenshots/*.png
.DS_Store

# needs the workflow OAuth scope to push: gh auth refresh -s workflow
.github/workflows/
# build outputs: never commit binaries or downloaded modules
stage/usr/bin/mystic-desktop
stage/usr/bin/ed25519-verify
stage/usr/share/mystic/apps/*/bin
stage/lib/modules/
stage/usr/share/fonts/*.ttf
stage/sbin/
stage/usr/lib/

# agent scratch space
.work/
# test hook for the scripted input device (see src/input.c). Root-anchored on
# purpose: the copy a test image needs lives at stage/run/mystic/, and that one
# must stay VISIBLE in `git status` - hiding it is how it survived long enough
# to be packed into an image. tools/mkimage.py warns when it packs run/, and
# tools/release.sh + tools/mkiso.py refuse an initramfs that carries it.
/run/mystic/input-script
